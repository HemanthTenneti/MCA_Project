# Phase I Target Makefile - Hemanth
# Builds and validates all Phase I deliverables

.PHONY: phase1 phase1-test phase1-report phase1-report-validate

phase1: phase1-test phase1-report phase1-validate
	@echo "✓ Phase I deliverables complete"
	@echo "  - IEEE Report: PHASE1_REPORT.md"
	@echo "  - Video Script: docs/video_script.md"
	@echo "  - Submission: SUBMISSION.md"
	@echo "  - Repository: Ready for GitHub push"

phase1-test:
	@echo "Running Phase I validation..."
	$(MAKE) test
	$(MAKE) lint
	@echo "✓ All tests passing"

phase1-report: PHASE1_REPORT.md
	@echo "✓ IEEE report generated"
	@wc -l PHASE1_REPORT.md
	@grep -c "##" PHASE1_REPORT.md | xargs -I {} echo "  {} sections"

phase1-validate:
	@echo "Validating Phase I completeness..."
	@test -f PHASE1_REPORT.md || { echo "✗ Missing PHASE1_REPORT.md"; exit 1; }
	@test -f CONTRIBUTIONS.md || { echo "✗ Missing CONTRIBUTIONS.md"; exit 1; }
	@test -f SUBMISSION.md || { echo "✗ Missing SUBMISSION.md"; exit 1; }
	@test -f docs/video_script.md || { echo "✗ Missing video script"; exit 1; }
	@git log --oneline | wc -l | xargs -I {} echo "✓ Git history: {} commits"
	@echo "✓ All Phase I deliverables present"

phase1-report-validate: PHASE1_REPORT.md
	@echo "Checking IEEE report structure..."
	@grep -q "Abstract" PHASE1_REPORT.md && echo "✓ Abstract present"
	@grep -q "Literature Review" PHASE1_REPORT.md && echo "✓ Literature Review present"
	@grep -q "Proposed Solution" PHASE1_REPORT.md && echo "✓ Proposed Solution present"
	@grep -q "Results" PHASE1_REPORT.md && echo "✓ Results section present"
	@grep -q "Individual Contributions" PHASE1_REPORT.md && echo "✓ Contributions documented"
	@grep -q "References" PHASE1_REPORT.md && echo "✓ References present"
	@echo "✓ Report structure complete"
