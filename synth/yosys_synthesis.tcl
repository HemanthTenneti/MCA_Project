# Yosys Synthesis Script for Branch Predictor
# Target: iCE40 HX8K CT256
# Frequency: 25 MHz
# Author: Arina

set design_name "branch_predictor"
set rtl_files {
    ../rtl/predictor_always_not_taken.v
    ../rtl/predictor_1bit.v
    ../rtl/predictor_2bit.v
    ../rtl/btb.v
    ../rtl/harness.v
    ../rtl/recovery.v
}

# Read RTL
foreach file $rtl_files {
    read_verilog -sv $file
}

# Elaborate design
hierarchy -top harness
proc

# Optimization
opt -fast
fsm
opt

# Mapping to iCE40
techmap -map +/ice40/cells_map.v
opt -fast

# Packing
ice40_opt
ice40_pack

# Place and route
nextpnr --hx8k --json synth.json --asc synth.asc --freq 25

# Generate timing report
# Report will be generated by nextpnr

echo "Synthesis complete: synth.asc (bitstream), synth.json (netlist)"
